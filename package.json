{
  "name": "juice-box",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A pick tracker that prices props against the vig, logs every pick before the game, and grades itself honestly.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
