{
  "name": "juice-box",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "description": "A pick tracker that prices props against the vig, logs every pick before the game, and grades itself honestly.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "picks": "tsx scripts/run-daily.ts",
    "grade": "tsx scripts/run-grade.ts",
    "links": "tsx scripts/run-links.ts",
    "streaks": "tsx scripts/run-streaks.ts",
    "minutes": "tsx scripts/run-minutes.ts",
    "grade-streaks": "tsx scripts/run-grade-streaks.ts",
    "blowouts": "tsx scripts/run-blowouts.ts",
    "team-trends": "tsx scripts/run-team-trends.ts",
    "leans": "tsx scripts/run-leans.ts",
    "lines": "tsx scripts/run-lines.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^25.0.1",
    "playwright": "^1.49.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
